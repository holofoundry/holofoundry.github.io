---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-white/10 bg-surface text-fg">
  <div class="pad-x mx-auto flex max-w-[1400px] flex-col gap-10 py-12 md:flex-row md:justify-between">
    <div class="max-w-md">
      <a href="/" class="inline-block pb-8" aria-label={`${site.name} home`}>
        <img
          src="/holofoundry-white.png"
          alt=""
          width="280"
          height="80"
          class="h-12 w-auto"
          loading="lazy"
        />
      </a>
      <div class="space-y-1 text-xs leading-relaxed text-white/70">
        <p>{site.legal.company} is a company registered in England and Wales.</p>
        <p>Company number: 08778935.</p>
        <p>Registered office: {site.legal.address}</p>
        <p>{site.legal.vat}</p>
      </div>
    </div>

    <nav class="flex flex-col gap-3 text-[15px] md:items-end" aria-label="Footer">
      {
        [...site.nav, { href: '/contact', label: 'Contact' }].map((item) => (
          <a href={item.href} class="text-white/80 transition-colors hover:text-fg hover:underline">
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${site.email}`}
        class="text-white/80 transition-colors hover:text-fg hover:underline"
      >
        {site.email}
      </a>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="pad-x mx-auto max-w-[1400px] py-4 text-center text-xs text-white/60">
      © {year} {site.legal.company}. All rights reserved. {site.legal.trading}
    </div>
  </div>
</footer>
