---
import { site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-bg/80 backdrop-blur-md">
  <div class="pad-x mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${site.name} home`}>
      <img
        src="/holofoundry-white.png"
        alt=""
        width="180"
        height="40"
        class="h-8 w-auto"
      />
    </a>

    <nav class="flex items-center gap-4 text-sm font-medium text-muted sm:gap-6 md:gap-8" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'transition-colors hover:text-fg',
              path === item.href || path.startsWith(`${item.href}/`) ? 'text-fg' : '',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="rounded-full bg-accent px-4 py-2 text-sm font-semibold text-fg transition-opacity hover:opacity-90"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
