---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chapter from '../../components/Chapter.astro';
import MicroLabel from '../../components/MicroLabel.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Blog"
  description="Writing from Holo Foundry on delivery, discovery, AppSheet, and building technology people actually use."
>
  <Chapter class="pt-28!" minHeight={false}>
    <MicroLabel class="mb-6">Blog</MicroLabel>
    <h1 class="display mb-6 max-w-4xl">Notes from the foundry</h1>
    <p class="lead mb-16 max-w-2xl">
      Delivery opinions, hard questions, and the occasional playbook — written for people who have to
      ship.
    </p>
    <ul class="divide-y divide-white/10 border-y border-white/10">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col gap-3 py-10 transition-colors md:flex-row md:justify-between"
            >
              <div class="max-w-3xl">
                <time class="micro mb-3 block text-muted!" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <h2 class="text-2xl font-semibold tracking-tight text-fg group-hover:text-accent sm:text-3xl">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-muted">{post.data.description}</p>
              </div>
              <span class="shrink-0 self-start text-sm font-semibold text-muted group-hover:text-fg md:mt-8">
                Read →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Chapter>
</BaseLayout>
